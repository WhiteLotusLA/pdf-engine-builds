# Every pin the build scripts use. KEY=VALUE only: no quotes, no spaces. Read by scripts/common.sh (load_versions)
# and by the workflows. Refresh rule: PDFIUM_BRANCH moves to a newer chromium/NNNN at least every 90 days.
# PDFium release branch (newest pdfium-binaries release, confirmed upstream).
PDFIUM_BRANCH=chromium/8100
# The EmbedPDF runtime fork and the commit on embedpdf/main that the patch series is derived from.
EMBEDPDF_REPO=https://github.com/embedpdf/runtime
EMBEDPDF_COMMIT=ed2f716e5381e34f096cc1e50e4259a55998d391
# The upstream PDFium commit the fork last merged; the series is the fork's change on top of it.
EMBEDPDF_UPSTREAM_BASE=59ea54cce0179db3269c4c58874249597ca3b118
QPDF_VERSION=12.4.2
LIBJPEG_TURBO_VERSION=3.2.0
MACOS_MIN=27.0
IOS_MIN=27.0
DEPOT_TOOLS_COMMIT=889099791deff38466d471fa6590951c91a1d8ab
