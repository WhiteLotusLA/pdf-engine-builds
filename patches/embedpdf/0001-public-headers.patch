+} FPDF_ANNOT_LINE_END;
+
+typedef enum FPDF_STANDARD_FONT {
+  FPDF_FONT_UNKNOWN = -1,
+  FPDF_FONT_COURIER = 0,
+  FPDF_FONT_COURIER_BOLD,
