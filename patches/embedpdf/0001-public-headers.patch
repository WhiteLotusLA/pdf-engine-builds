+
+typedef enum FPDF_BLENDMODE {
+  FPDF_BLENDMODE_Normal = 0,
+  FPDF_BLENDMODE_Multiply,
+  FPDF_BLENDMODE_Screen,
+  FPDF_BLENDMODE_Overlay,
