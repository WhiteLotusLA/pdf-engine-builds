+  // promoted object's birth name.
+  std::map<uint32_t, CPDF_PageBirths> births_;
+  std::map<uint32_t, std::pair<uint32_t, uint32_t>> birth_names_;
+  OpenStatus ingest_status_ = OpenStatus::kSuccess;
