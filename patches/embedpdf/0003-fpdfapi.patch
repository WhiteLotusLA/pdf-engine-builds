+#ifndef CORE_FPDFAPI_PARSER_CPDF_REFERENCE_INDEX_H_
+#define CORE_FPDFAPI_PARSER_CPDF_REFERENCE_INDEX_H_
+
+#include <stdint.h>
+
+#include <array>
