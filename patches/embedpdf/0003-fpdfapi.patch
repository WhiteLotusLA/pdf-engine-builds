index 0000000000000000000000000000000000000000..18ab2db0ed0f469eb790df107b5150b6dc5944df
--- /dev/null
+++ b/core/fpdfapi/edit/cpdf_resourceuse.h
@@ -0,0 +1,93 @@
+// Copyright 2026 CloudPDF LTD
+// SPDX-License-Identifier: Apache-2.0
+
+#ifndef CORE_FPDFAPI_EDIT_CPDF_RESOURCEUSE_H_
+#define CORE_FPDFAPI_EDIT_CPDF_RESOURCEUSE_H_
+
+#include <map>
+#include <set>
+#include <tuple>
+#include <utility>
+
+#include "core/fxcrt/bytestring.h"
+#include "core/fxcrt/retain_ptr.h"
+#include "core/fxcrt/unowned_ptr.h"
+
+class CPDF_Dictionary;
+class CPDF_Document;
+class CPDF_Object;
+class CPDF_Stream;
+
+// Which names of a resource dictionary content uses without naming the
+// dictionary itself: a form drawn with no /Resources of its own, the glyphs
+// of a Type3 font, a soft mask's group, an annotation's appearance - and what
+// those draw in turn. Where content looks a name up is the page layer's rule,
+// as the parser and renderer follow it: CPDF_Form::ChooseResourcesDict() and
+// ChooseResourcesOfType(), CPDF_Type3Font::GlyphsUseContentResources(), a
+// soft mask's group reading the page's resources without its own
+// (CPDF_RenderStatus::LoadSMask()) and a tiling pattern only its own
+// (CPDF_TilingPattern::Load()).
+class CPDF_ResourceUse {
+ public:
+  // The resource types whose names are tracked.
+  static constexpr const char* kTypes[] = {"ExtGState",  "Font",    "XObject",
+                                           "ColorSpace", "Pattern", "Shading"};
+
+  using NamesByType = std::map<ByteString, std::set<ByteString>>;
+
+  CPDF_ResourceUse(CPDF_Document* document,
+                   RetainPtr<const CPDF_Dictionary> resources);
+  ~CPDF_ResourceUse();
+
+  // Walks `content`, which looks names up in `content_resources` and, for a
+  // type they lack, in `fallback`: its names of each type that lands in our
+  // dictionary of it are used, and what it draws - forms, soft masks' groups,
+  // tiling patterns and the glyphs of the Type3 fonts it selects - is walked
+  // in turn. One stream can be read with different resources in different
+  // places, so it is walked once for each.
+  void Walk(const CPDF_Stream* content,
+            const CPDF_Dictionary* content_resources,
+            const CPDF_Dictionary* fallback);
+
+  // Walks the glyphs of the Type3 fonts `content_resources` (else
+  // `fallback`) name `font_names`: a glyph procedure is a form whose page
+  // resources are the font's, or without them the resources of the content
+  // selecting the font (CPDF_Type3Font::LoadChar(), SetPageResources()).
+  void WalkType3Glyphs(const std::set<ByteString>& font_names,
+                       const CPDF_Dictionary* content_resources,
+                       const CPDF_Dictionary* fallback);
+
+  // The page's resources, which a soft mask's group without its own reads.
+  void SetPageResources(RetainPtr<const CPDF_Dictionary> page_resources) {
+    page_resources_ = std::move(page_resources);
+  }
+
+  // The group of the soft mask graphics state `state` sets, if any.
+  static RetainPtr<const CPDF_Stream> SoftMaskGroup(
+      RetainPtr<const CPDF_Dictionary> state);
+  // `pattern`'s stream when it is a tiling pattern: content of its own.
+  static RetainPtr<const CPDF_Stream> TilingPatternStream(
+      RetainPtr<const CPDF_Object> pattern);
+
+  // The names of our resources used so far, by type.
+  const NamesByType& used() const { return used_; }
+
+ private:
+  void WalkSoftMasks(const std::set<ByteString>& state_names,
+                     const CPDF_Dictionary* content_resources,
+                     const CPDF_Dictionary* fallback);
+  void WalkTilingPatterns(const std::set<ByteString>& pattern_names,
+                          const CPDF_Dictionary* content_resources,
+                          const CPDF_Dictionary* fallback);
+
+  UnownedPtr<CPDF_Document> const document_;
+  RetainPtr<const CPDF_Dictionary> const resources_;
+  RetainPtr<const CPDF_Dictionary> page_resources_;
+  NamesByType used_;
+  std::set<std::tuple<const CPDF_Stream*,
+                      const CPDF_Dictionary*,
+                      const CPDF_Dictionary*>>
+      walked_;
+};
+
+#endif  // CORE_FPDFAPI_EDIT_CPDF_RESOURCEUSE_H_
diff --git a/core/fpdfapi/edit/cpdf_save_object_reader.cpp b/core/fpdfapi/edit/cpdf_save_object_reader.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d74d514981371f1519584c0d23575bfaee2df1d6
--- /dev/null
+++ b/core/fpdfapi/edit/cpdf_save_object_reader.cpp
@@ -0,0 +1,108 @@
+// Copyright 2026 CloudPDF LTD
+// SPDX-License-Identifier: Apache-2.0
+
+#include "core/fpdfapi/edit/cpdf_save_object_reader.h"
+
+#include <utility>
+
+#include "core/fpdfapi/parser/cpdf_base_document.h"
+#include "core/fpdfapi/parser/cpdf_document.h"
+#include "core/fpdfapi/parser/cpdf_layer_document.h"
+#include "core/fpdfapi/parser/cpdf_object_walker.h"
+#include "core/fpdfapi/parser/cpdf_parser.h"
+
+namespace {
+
+constexpr size_t kSaveObjectStreamCacheBytes = 8 * 1024 * 1024;
+
+}  // namespace
+
+CPDF_SaveObjectReader::CPDF_SaveObjectReader(CPDF_Document* document,
+                                             Version version)
+    : document_(document),
+      parser_(document->GetParser()),
+      version_(version),
+      stream_cache_(kSaveObjectStreamCacheBytes) {}
+
+CPDF_SaveObjectReader::~CPDF_SaveObjectReader() = default;
+
+RetainPtr<const CPDF_Object> CPDF_SaveObjectReader::Read(
+    uint32_t object_number) {
+  dependencies_.clear();
+  GetByteStringPool()->Clear();
+  return ReadObject(object_number);
+}
+
+RetainPtr<const CPDF_Object> CPDF_SaveObjectReader::ReadObject(
+    uint32_t object_number) {
+  if (auto cached = ReadCachedObject(object_number)) {
+    return cached;
+  }
+  return parser_ ? parser_->ParseIndirectObjectForSave(object_number, this,
+                                                       &stream_cache_)
+                 : nullptr;
+}
+
+bool CPDF_SaveObjectReader::IsCached(uint32_t object_number) const {
+  return !!ReadCachedObject(object_number);
+}
+
+RetainPtr<const CPDF_Object> CPDF_SaveObjectReader::ReadCachedObject(
+    uint32_t object_number) const {
+  if (const auto* layer = CPDF_LayerDocument::FromDocument(document_)) {
+    if (version_ == Version::kEffective) {
+      if (auto promoted = layer->FindPromotedObject(object_number)) {
+        return promoted;
+      }
+    }
+    // The base lookup is cache-only. The layer's GetIndirectObject() would
+    // lazily populate the shared base cache on a miss.
+    if (auto cached =
+            layer->GetBaseDocument()->GetIndirectObject(object_number)) {
+      return cached;
+    }
+  } else if (version_ == Version::kEffective) {
+    if (auto cached = document_->GetIndirectObject(object_number)) {
+      return cached;
+    }
+  }
+
+  return nullptr;
+}
+
+CPDF_Object* CPDF_SaveObjectReader::GetOrParseIndirectObjectInternal(
+    uint32_t object_number) {
+  auto it = dependencies_.find(object_number);
+  if (it != dependencies_.end()) {
+    return const_cast<CPDF_Object*>(it->second.Get());
+  }
+
+  auto object = ReadObject(object_number);
+  if (!object) {
+    return nullptr;
+  }
+  auto* result = const_cast<CPDF_Object*>(object.Get());
+  dependencies_.emplace(object_number, std::move(object));
+  return result;
+}
+
+pdfium::span<const uint32_t> CPDF_SaveObjectReader::ReferencesFor(
+    uint32_t object_number) {
+  if (auto live = ReadCachedObject(object_number)) {
+    references_ = CPDF_CollectReferences(std::move(live));
+    return references_;
+  }
+  auto* index = parser_ ? parser_->GetSaveReferenceIndex() : nullptr;
+  if (index) {
+    if (auto references = index->Find(object_number)) {
+      return *references;
+    }
+  }
+  auto object = Read(object_number);
+  references_ = CPDF_CollectReferences(object);
+  // A failed read is not evidence that an object has no outgoing references.
+  if (object && index) {
+    index->Insert(object_number, references_);
+  }
+  return references_;
+}
diff --git a/core/fpdfapi/edit/cpdf_save_object_reader.h b/core/fpdfapi/edit/cpdf_save_object_reader.h
new file mode 100644
