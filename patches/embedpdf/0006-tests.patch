+
+  int status = -1;
+  EXPECT_EQ(FLATTEN_FAIL,
+            EPDFPage_FlattenAnnotations(page.get(), nullptr, 1,
+                                        FLAT_NORMALDISPLAY, &status));
+  FPDF_ANNOTATION just_visible[] = {visible.get()};
+  EXPECT_EQ(FLATTEN_FAIL,
