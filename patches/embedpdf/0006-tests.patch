+  EXPECT_FLOAT_EQ(1.0f, upright_matrix.a);
+  EXPECT_FLOAT_EQ(0.0f, upright_matrix.b);
+  EXPECT_FLOAT_EQ(0.0f, upright_matrix.c);
+  EXPECT_FLOAT_EQ(1.0f, upright_matrix.d);
+}
