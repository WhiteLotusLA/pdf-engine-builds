+  std::string ExportedBytes(FPDF_ANNOTATION annot) {
+    ScopedFPDFDocument exported(EPDFAnnot_ExportAppearance(annot, 0, nullptr));
+    EXPECT_TRUE(exported);
+    return exported ? SavedBytes(exported.get()) : std::string();
+  }
