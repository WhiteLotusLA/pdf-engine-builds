+TEST(CPDFReadOnlyGraphGuardTest, ActiveStateStacks) {
+  EXPECT_FALSE(CPDF_ReadOnlyGraphGuard::IsActive());
+  {
+    CPDF_ReadOnlyGraphGuard guard;
