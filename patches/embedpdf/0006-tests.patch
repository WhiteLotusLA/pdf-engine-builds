+std::string GetWidgetOnState(EPDF_FORM_MODEL model,
+                             int field_index,
+                             int widget_index) {
+  unsigned long length_bytes = EPDFForm_GetFieldWidgetOnState(
+      model, field_index, widget_index, nullptr, 0);
+  if (length_bytes == 0) {
+    return std::string();
+  }
