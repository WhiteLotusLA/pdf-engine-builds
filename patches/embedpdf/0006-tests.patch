+      ReadTree(saved.get(), EPDF_NAMED_PAGE_TREE_PAGES);
+  ASSERT_EQ(3u, pages.size());
+  EXPECT_EQ(L"#alpha=Alpha", pages[0].key);
+  EXPECT_EQ(L"Approved=Goedgekeurd", pages[1].key);
+  EXPECT_EQ(L"Stämpel=Stämpel", pages[2].key);
