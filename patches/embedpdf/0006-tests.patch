+  EXPECT_EQ(0.5f, opacity);
+  ASSERT_TRUE(EPDFAnnot_SetOpacity(annot.get(), 0.3f));
+  ASSERT_TRUE(EPDFAnnot_GetOpacity(annot.get(), &opacity));
+  EXPECT_EQ(0.3f, opacity);
