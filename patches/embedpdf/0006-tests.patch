+  EXPECT_EQ(image.Get(), cached_image.Get());
+  EXPECT_EQ(promoted_stream.Get(), cached_image->GetStream().Get());
+  pdfium::span<const uint8_t> raw_data =
+      cached_image->GetStream()->GetInMemoryRawData();
+  ASSERT_EQ(3u, raw_data.size());
