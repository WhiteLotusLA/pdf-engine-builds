+// Closing a page mid-load abandons the load; the document loads it again.
+TEST_F(EPDFSlicedLoadEmbedderTest, ClosingMidLoadAbandonsIt) {
+  const std::string pdf = OneHugeForm(5000);
+  Parsed expected;
