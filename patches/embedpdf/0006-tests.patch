+        RetainPtr<const CPDF_Dictionary> fonts =
+            pdf->GetPageDictionary(kType3GlyphNamesAndText)
+                ->GetDictFor("Resources")
+                ->GetDictFor("Font");
+        ASSERT_TRUE(fonts);
