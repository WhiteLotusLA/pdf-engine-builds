+  ASSERT_TRUE(EPDFLayer_BeginTransaction(doc.get()));
+  AddPngStamp(doc.get(), first.get(), kBluePng, kStampRect);
+  EXPECT_EQ(kBlue, ColorAt(first.get(), kStampX, kStampY));
