+  ASSERT_TRUE(artifact_replayed);
+  ScopedFPDFPage artifact_page(FPDF_LoadPage(artifact_replayed.get(), 0));
+  ASSERT_TRUE(artifact_page);
+  EXPECT_EQ(1, FPDFPage_GetAnnotCount(artifact_page.get()));
