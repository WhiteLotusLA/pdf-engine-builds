+TEST_F(CPDFBaseDocumentTest, ReadMissAfterFreezeParsesInsteadOfDying) {
+  const std::string pdf = BuildPdfWithOrphanObject();
+  RetainPtr<CPDF_BaseDocument> document = LoadBaseDocumentFromString(pdf);
+  ASSERT_TRUE(document);
