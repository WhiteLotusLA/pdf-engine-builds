+  void CompareJavaScriptReadApis(FPDF_DOCUMENT plain,
+                                 FPDF_DOCUMENT layer,
+                                 const char* file_name) {
+    const int plain_count = FPDFDoc_GetJavaScriptActionCount(plain);
+    ASSERT_EQ(plain_count, FPDFDoc_GetJavaScriptActionCount(layer))
+        << file_name;
