+                                        FLAT_NORMALDISPLAY, &status));
+  EXPECT_EQ(EPDF_FLATTEN_STATUS_NOT_ON_PAGE, status);
+  EXPECT_EQ(6, FPDFPage_GetAnnotCount(page.get()));
+
