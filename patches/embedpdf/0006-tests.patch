+  CPDF_Document* pdf() { return CPDFDocumentFromFPDFDocument(doc_.get()); }
+  RetainPtr<CPDF_Dictionary> annot_dict() {
+    return CPDFAnnotContextFromFPDFAnnotation(annot_.get())
+        ->GetMutableAnnotDict();
