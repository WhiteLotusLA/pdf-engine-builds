+        ScopedFPDFAnnotation annot(
+            EPDFPage_CreateAnnot(page.get(), FPDF_ANNOT_TEXT));
+        ASSERT_TRUE(annot);
+      }
+      EXPECT_EQ(expected_annots, FPDFPage_GetAnnotCount(page.get()));
