+        doc.get(), ObjectNumberOf(doc.get(), 0), /*normalized=*/false));
+    LoadUntilPlaced(loading.get(), 3);
+    ASSERT_EQ(CPDF_PageObjectHolder::ParseState::kNotParsed,
+              AsIs(loading.get())
+                  ->GetPageObjectByIndex(1)
+                  ->AsForm()
