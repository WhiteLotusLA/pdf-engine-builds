+ScopedFPDFBitmap Render(FPDF_PAGE page) {
+  ScopedFPDFBitmap bitmap(FPDFBitmap_Create(600, 600, 0));
+  FPDFBitmap_FillRect(bitmap.get(), 0, 0, 600, 600, 0xffffffff);
+  FPDF_RenderPageBitmap(bitmap.get(), page, 0, 0, 600, 600, 0, 0);
+  return bitmap;
+}
