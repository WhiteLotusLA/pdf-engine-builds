+  EXPECT_EQ(EPDF_SIG_COVERAGE_WHOLE_REVISION, EPDFSig_GetCoverage(model, ts));
+  EXPECT_EQ(2, EPDFSig_GetRevisionIndex(model, ts));
+  EPDFSig_CloseModel(model);
+}
