+  for (int i = 0; i < FPDFPage_GetAnnotCount(page.get()); ++i) {
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(page.get(), i));
+    if (FPDFAnnot_GetSubtype(annot.get()) != FPDF_ANNOT_FREETEXT) {
+      continue;
