+  ASSERT_TRUE(EPDFAnnot_GenerateAppearance(slanted.get()));
+  ASSERT_TRUE(FPDFAnnot_GetRect(slanted.get(), &rect));
+  EXPECT_NEAR(98.8f, rect.left, 1e-4);
+  EXPECT_NEAR(551.6f, rect.top, 1e-4);
