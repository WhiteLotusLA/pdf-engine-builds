+  // Writing what the file already holds writes nothing and promotes nothing
+  // further.
+  ASSERT_TRUE(EPDFForm_SetFieldWidgetsChecked(doc.layer, 6u, second_on, 2,
+                                              nullptr, 0, &changed_count));
+  EXPECT_EQ(0ul, changed_count);
