+}
+
+// A form that draws itself: the recursion guard stops it at the same depth.
+TEST_F(EPDFSlicedLoadEmbedderTest, AFormThatDrawsItself) {
+  const std::string pdf = OnePage(
+      "<< /XObject << /Self 5 0 R >> >>", "/Self Do",
