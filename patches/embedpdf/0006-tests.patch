+TEST_F(EPDFAnnotEmbedderTest, RichTextJsonFromAcrobatProperties) {
+  ASSERT_TRUE(OpenDocument("freetext_rich_text_acrobat_properties.pdf"));
+  ScopedPage page = LoadScopedPage(0);
