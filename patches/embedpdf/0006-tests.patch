+  int most_slices = 0;
+  for (const char* file : kFiles) {
+    ASSERT_TRUE(OpenDocument(file)) << file;
+    const int page_count = std::min(FPDF_GetPageCount(document()), 4);
+    for (int i = 0; i < page_count; ++i) {
