+    CFX_FloatRect envelope =
+        form->GetMatrixFor("Matrix").TransformRect(form->GetRectFor("BBox"));
+    envelope.Normalize();
+    ephemeral_rect_ = envelope;
+  }
+  has_generated_ap_ = true;
+  return ephemeral_normal_ap_;
+}
