+FPDF_EXPORT unsigned long FPDF_CALLCONV
+EPDFForm_ExportFDF(FPDF_DOCUMENT document,
+                   FPDF_WIDESTRING pdf_path,
+                   uint32_t export_flags,
+                   void* buffer,
+                   unsigned long buflen) {
+  ScopedFPDFDocumentView document_view(document);
