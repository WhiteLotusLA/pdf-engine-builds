@@ -0,0 +1,3444 @@
+// Copyright 2026 CloudPDF LTD
+// SPDX-License-Identifier: Apache-2.0
+
+#include "public/epdf_form.h"
+
+#include <algorithm>
+#include <array>
+#include <map>
+#include <memory>
