+  if (!ValidAxis(axis)) {
+    return 0;
+  }
+  PathView view(measure, Kind::kMeasure);
+  auto array = view.Get() ? view.Get()->GetArrayFor(CPDF_Measure::KeyForAxis(
+                                static_cast<Axis>(axis)))
+                          : nullptr;
