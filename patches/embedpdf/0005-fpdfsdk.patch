+namespace {
+
+const CPDF_Document* DocOf(FPDF_ANNOTATION annot) {
+  CPDF_AnnotContext* context = CPDFAnnotContextFromFPDFAnnotation(annot);
+  return context ? context->GetPage()->GetDocument() : nullptr;
+}
