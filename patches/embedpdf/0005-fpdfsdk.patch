+    return nullptr;
+
+  RetainPtr<CPDF_Dictionary> outlines = GetOrCreateOutlines(pDoc);
+  if (!outlines)
+    return nullptr;
+
+  WideString wtitle =
+      title ? UNSAFE_BUFFERS(WideStringFromFPDFWideString(title)) : WideString();
+
+  RetainPtr<CPDF_Dictionary> node = CreateBookmarkDict(pDoc, wtitle);
