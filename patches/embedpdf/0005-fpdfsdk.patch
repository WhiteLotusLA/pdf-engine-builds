+const ActionNodeRecord* GetNode(EPDF_ACTION_MODEL model,
+                                EPDF_ACTION_NODE_ID node) {
+  const ActionModelData* data = DataFromHandle(model);
+  return data && node < data->nodes.size() ? &data->nodes[node] : nullptr;
+}
