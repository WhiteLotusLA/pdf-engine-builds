+FPDF_EXPORT void FPDF_CALLCONV
+EPDF_ReleaseBaseDocument(EPDF_BASE_DOCUMENT base) {
+  RetainPtr<CPDF_BaseDocument> retained;
+  retained.Unleak(CPDFBaseDocumentFromEPDFBaseDocument(base));
+}
