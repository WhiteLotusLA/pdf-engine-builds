+    if (units != 1) {
+      if (static_cast<size_t>(required) < out.size()) {
+        out[static_cast<size_t>(required)] = {i + 1, offset + units};
+      }
+      ++required;
+    }
+    offset += units;
+  }
+  return required;
+}
