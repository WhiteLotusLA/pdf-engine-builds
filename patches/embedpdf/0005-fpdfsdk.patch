+#include "core/fpdfdoc/cpdf_embed_metadata.h"
+#include "core/fpdfdoc/cpdf_formcontrol.h"
+#include "core/fpdfdoc/cpdf_formfield.h"
+#include "core/fpdfdoc/cpdf_interactiveform.h"
+#include "core/fxcrt/bytestring.h"
