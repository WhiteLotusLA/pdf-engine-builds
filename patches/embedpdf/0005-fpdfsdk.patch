+const SignatureRecord* GetRecord(EPDF_SIGNATURE_MODEL model, int index) {
+  const SignatureModel* m = ModelFromHandle(model);
+  if (!m || index < 0 || index >= fxcrt::CollectionSize<int>(m->records)) {
+    return nullptr;
